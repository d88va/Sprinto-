# Set these in .env.local for dev and in Vercel > Project > Settings > Environment Variables for prod.
# Never commit real values.
ANTHROPIC_API_KEY=
HUNTER_API_KEY=
# Neon: Dashboard > Connection Details > pooled connection string
DATABASE_URL=
# Gmail App Password (Google Account > Security > 2-Step Verification > App passwords)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Case brief: hardcode the recipient to your own address
SEND_TO=
SENDER_NAME=
# Protects the dashboard + API (HTTP basic auth, any username). Required: app fails closed without it.
DASHBOARD_PASSWORD=
# Set to 1 to skip the real Gmail send (approve just marks the email as drafted)
DRY_RUN=1
# Optional
# SPRINTO_MODEL=claude-opus-5-5
