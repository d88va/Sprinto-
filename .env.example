# Set these in .env.local for dev and in Vercel > Project > Settings > Environment Variables for prod.
# Never commit real values.
# AI: set ONE of these. Gemini works on Google's free tier; Anthropic is used first if both are set.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
HUNTER_API_KEY=
# Neon: Dashboard > Connection Details > pooled connection string
DATABASE_URL=
# Gmail App Password (Google Account > Security > 2-Step Verification > App passwords)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Case brief: hardcode the recipient to your own address
SEND_TO=
SENDER_NAME=
# Optional: the app is open by default. Set a password here to require login (HTTP basic auth, any username).
DASHBOARD_PASSWORD=
# 1 = approving records the email but does not send; set to 0 to send for real (approve just marks the email as drafted)
DRY_RUN=1
# Optional
# GEMINI_MODEL=gemini-3.8-flash
# SPRINTO_MODEL=claude-opus-5-5
